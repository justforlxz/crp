{
  "note": "本文件是原型模块的可核对清单。模块名必须与 prototype.html 里的 class 完全一致。",
  "global": [".modal", ".toast", ".section-title"],
  "pages": {
    "dashboard": {
      "route": "/dashboard",
      "sources": ["app/(app)/dashboard/"],
      "modules": [".stats", ".stat", ".stat-ico", ".queue-list", ".queue-item", ".tip", ".empty", ".table-scroll"]
    },
    "releases": {
      "route": "/releases",
      "sources": ["app/(app)/releases/page.tsx", "app/(app)/releases/"],
      "modules": [".page-tabs", ".filters", ".search-field", ".table-scroll", ".empty"]
    },
    "detail": {
      "route": "/releases/[id]",
      "sources": ["app/(app)/releases/[id]/"],
      "modules": [".summary-strip", ".summary-cell", ".table-scroll", ".project-card", ".timeline", ".tl-item", ".risk-box", ".tip"]
    },
    "projects": {
      "route": "/projects",
      "sources": ["app/(app)/projects/", "app/(app)/managers/"],
      "modules": [".section-title", ".manager-grid", ".manager-card", ".filters", ".project-grid", ".project-card", ".project-software-chips", ".tip", ".table-scroll"]
    },
    "packages": {
      "route": "/packages",
      "sources": ["app/(app)/packages/"],
      "modules": [".table-scroll", ".tip"]
    },
    "baselines": {
      "route": "/baselines",
      "sources": ["app/(app)/baselines/"],
      "modules": [".table-scroll", ".tip"]
    },
    "queue": {
      "route": "/queue",
      "sources": ["app/(app)/queue/"],
      "modules": [".stats", ".stat", ".stat-ico", ".dep-flow", ".dep-row", ".queue-list", ".queue-item", ".tip", ".table-scroll"]
    },
    "webhooks": {
      "route": "/webhooks",
      "sources": ["app/(app)/webhooks/"],
      "modules": [".tip", ".table-scroll"]
    },
    "managers": {
      "route": "/managers",
      "sources": ["app/(app)/managers/"],
      "modules": [".manager-grid", ".manager-card", ".table-scroll"]
    }
  }
}
