# 复制本文件为 .env 后填写。.env 已被 .gitignore 忽略，不要提交真实凭据。

# PostgreSQL 连接串，必需。Prisma CLI 与应用运行都读取这一个变量。
# 格式：postgresql://<用户>:<密码>@<主机>:<端口>/<库名>?schema=public
DATABASE_URL="postgresql://crp:crp@localhost:5432/crp?schema=public"

# --- Gerrit 与 gitiles（A3 节点接入） ---
# 匿名访问会 302 跳登录页，这三项必须配齐才能读到分支、提交与 debian/changelog。
# 凭据在 Gerrit 网页 Settings → HTTP Credentials 生成，生成结果只显示一次。

# Gerrit 服务地址，可选，默认 https://gerrit.uniontech.com
GERRIT_BASE_URL="https://gerrit.uniontech.com"
# Gerrit 用户名
GERRIT_USERNAME=""
# Gerrit HTTP 凭据密码
GERRIT_HTTP_PASSWORD=""

# ---- Shuttle（https://shuttle.uniontech.com）----
# 只给 lib/integrations/shuttle/ 用，与 CRP 的变量互不相干，也不复用 CRP 的 token。
# 接口前缀，不填就用下面这个默认值。
# SHUTTLE_BASE_URL="https://shuttle.uniontech.com/api/shuttle"
# 可选。当前用到的三个读取接口（/repo/info、/task/list、/job/log）实测不校验身份，
# 所以不填也能用；填了才会随请求发出。
# SHUTTLE_TOKEN=""

# ---- CRP（https://crp.uniontech.com/api）----
# 写接口需要 LDAP 账号登录；只把值填在这里，不要提交。
# CRP_USERNAME=<LDAP 账号>
# CRP_PASSWORD=<LDAP 密码>
# 可选：接口前缀与 token 缓存位置。缓存文件写成 0600，按 JWT 的 exp 自动失效。
# CRP_BASE_URL="https://crp.uniontech.com/api"
# CRP_TOKEN_PATH="~/.cache/crp/jwt"

# ---- POST /api/jobs/baseline-sync 的定时任务 token ----
# 每小时由外部定时器（cron / systemd timer）POST 这个接口触发基线同步。与用户会话、
# PACKAGE_API_TOKEN 都无关；不配置时该接口一律返回 401。
# 生成方式示例：openssl rand -hex 32
# SYNC_JOB_TOKEN=""

# ---- POST /api/jobs/build-dispatch 的定时任务 token ----
# 每隔几分钟由外部定时器（cron / systemd timer）POST 这个接口，把在跑的提测往前推一步：
# 建 CRP Topic、按依赖顺序投递下一个包、轮询构建结果。这个接口会真的向 CRP 建 Topic、发 Release。
# 与用户会话、SYNC_JOB_TOKEN、PACKAGE_API_TOKEN 都无关；不配置时该接口一律返回 401。
# 生成方式示例：openssl rand -hex 32
# BUILD_DISPATCH_JOB_TOKEN=""

# ---- POST /api/jobs/build-poll 的定时任务 token ----
# 每隔几分钟由外部定时器（cron / systemd timer）POST 这个接口，轮询在跑的提测：
# 回写 Shuttle 的构建结果与 CRP 的工作流进度（Release.crpWorkProgress），并记调度事件流水。
# 已完结的提测自动不再轮询。与用户会话、SYNC_JOB_TOKEN、BUILD_DISPATCH_JOB_TOKEN 都无关；
# 不配置时该接口一律返回 401。
# 生成方式示例：openssl rand -hex 32
# BUILD_POLL_JOB_TOKEN=""

# ---- POST /api/packages 的独立 token ----
# 外部系统提交软件包时用，与用户会话无关。服务端没有这个变量时接口一律返回 401。
# 生成方式示例：openssl rand -hex 32
PACKAGE_API_TOKEN=""

# 验证脚本 scripts/verify-crp.ts 要投递哪个软件包、哪个分支、哪个提交。
# 这三个没有默认值：猜一个会把构建打到错误的提交上。
# CRP_VERIFY_PROJECT=dde-file-manager
# CRP_VERIFY_PROJECT_BRANCH=develop/eagle
# CRP_VERIFY_COMMIT=<40 位提交>
# 可选：交付分支名与提测版本号
# CRP_VERIFY_BRANCH=eagle-1071
# CRP_VERIFY_TAG=9.9.9
